# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Database
# Replace with your Neon/PostgreSQL connection string (never commit real credentials)
DATABASE_URL=postgresql://username:password@your-host.neon.tech/your_database?sslmode=require

# JWT
# Generate strong random secrets (min 32 characters) for production
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Google Gemini (AI Outreach) — optional; uses local fallback if unset
GEMINI_API_KEY=your_google_gemini_api_key_here
